# copy to .env and fill in; .env is git-ignored. Pick ONE provider (auto-detected from the keys, or set LLM_PROVIDER).
LLM_PROVIDER=            # anthropic | openai | local   (empty = anthropic if its key is set, else openai)

# --- Anthropic (default models: Haiku 4.5 router, Sonnet 5.5 generator/judge)
ANTHROPIC_API_KEY=
# ROUTER_MODEL=claude-haiku-4-5-20251001
# GENERATE_MODEL=claude-sonnet-5-5
# JUDGE_MODEL=claude-sonnet-5-5

# --- OpenAI
OPENAI_API_KEY=
# OPENAI_ROUTER_MODEL=gpt-5.4-mini
# OPENAI_GENERATE_MODEL=gpt-5.5
# OPENAI_JUDGE_MODEL=gpt-5.5

# --- Local model via any OpenAI-compatible server (Ollama, LM Studio, vLLM, llama.cpp)
# LLM_PROVIDER=local
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=your-model-name
# LOCAL_API_KEY=local
# Local-model tuning (see docs/local_model_plan.md):
# LOCAL_NO_THINK=1             switch hidden reasoning off (reasoning_effort=none; router/extractor always do)
# LLM_GEN_MAX_TOKENS=1500      answer budget (default 6000); LLM_ROUTER_MAX_TOKENS=600; LLM_EXTRACT_MAX_TOKENS=1500
# LLM_MAX_ATTEMPTS=2           verifier attempts per answer (3 can help small models)
# LLM_PROMPT_PROFILE=local     appends the citation/placeholder checklist (automatic when LLM_PROVIDER=local)
# LLM_PASSAGE_CHARS=900        characters of each passage shown to the model (600 on the laptop)

# EMBED_MODEL=BAAI/bge-m3

# Ask by voice (Whisper, local CPU). whisper-tiny is faster; whisper-small is much better at Arabic
WHISPER_MODEL=openai/whisper-base
