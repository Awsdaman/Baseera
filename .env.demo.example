# Live-demo settings (copy to .env.demo, which is git-ignored). start_demo.ps1 and tools/prewarm_cache.py read it.
# The LLM cache key covers model + prompts + token limits: pre-warm with EXACTLY these values, after the last code/DB change.
LLM_PROVIDER=local
LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL=gemma-4-12b-it
LOCAL_NO_THINK=1
LLM_GEN_MAX_TOKENS=1500
LLM_ROUTER_MAX_TOKENS=600
LLM_MAX_ATTEMPTS=2
LLM_CACHE=readonly
LLM_TIMEOUT=120
MAX_CONCURRENT_ANSWERS=2
QUEUE_TIMEOUT_S=240
MAX_QUEUE=10
TRUST_CF_IP=1
RATE_LIMIT_PER_MINUTE=12
WARM_EMBEDDINGS=1
KEEPALIVE_S=240
